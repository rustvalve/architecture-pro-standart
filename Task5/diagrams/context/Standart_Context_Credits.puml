@startuml
title Банк "Стандарт" - Диаграмма контекста C4 (TO BE) - Кредиты

top to bottom direction

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

' ===== Пользователи (Actors) =====
Person(client, "Клиент банка", "Физическое лицо, использующее услуги банка для получения кредитов")
Person(new_client, "Новый клиент", "Потенциальный клиент, подающий заявку на кредит через сайт")

' ===== Внутренние системы банка =====
System_Boundary(BankSystem, "Банк Стандарт") {
  Person(front_office, "Менеджер фронт-офиса", "Сотрудник отделения, работающий с клиентами напрямую, оформляет кредиты")
  Person(back_office_credit, "Менеджер бэк-офиса кредитов", "Сотрудник, обрабатывающий заявки на кредиты")

  System(internet_bank, "Интернет-банк", "Веб-приложение для клиентов: проведение платежей, открытие счетов, подача заявок на кредиты. ASP.NET MVC 4.5, MS SQL")
  System(website, "Сайт банка", "Маркетинговый сайт с возможностью подачи заявок на кредиты. PHP, React.js")
  System(abs, "АБС", "Автоматизированная банковская система: учёт операций по счетам, бухгалтерия, обработка заявок на кредиты. Delphi, Oracle, PL-SQL")
  System(credit_pipeline, "Кредитный конвейер", "Система управления кредитным процессом: условия кредитования, лимиты, одобрение заявок")
  System(scoring_system, "Система скоринга", "Система кредитной оценки клиентов, интеграция с БКИ")
  System(sms_gateway, "СМС-шлюз", "Отправка СМС-уведомлений и кодов подтверждения клиентам")
}

' ===== Внешние системы =====
System_Ext(bki, "БКИ (Бюро кредитных историй)", "Внешняя система для получения кредитных историй клиентов")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор для отправки СМС")

' ===== Связи клиентов с системами =====
Rel(new_client, website, "Подаёт заявку на кредит, просматривает условия, получает решение по скорингу", "HTTPS")
Rel(client, internet_bank, "Подаёт заявки на кредиты, видит предодобренные предложения", "HTTPS")
Rel(client, front_office, "Приходит в отделение для идентификации и оформления кредита")

' ===== Связи сотрудников с системами =====
Rel(front_office, abs, "Создаёт заявки на кредиты, оформляет кредиты, продолжает работу с предодобренными заявками")
Rel(back_office_credit, abs, "Обрабатывает заявки на кредиты, определяет условия")
Rel(back_office_credit, credit_pipeline, "Получает информацию об условиях кредитования")

' ===== Связи между системами =====
Rel(website, credit_pipeline, "Передаёт заявки на кредиты", "API")
Rel(website, scoring_system, "Запрашивает скоринг для новых клиентов", "API")

Rel(internet_bank, abs, "Получает данные о счетах клиентов", "DB/API")
Rel(internet_bank, credit_pipeline, "Получает условия кредитования и предодобренные предложения, создаёт заявки", "API")
Rel(internet_bank, scoring_system, "Запрашивает скоринг клиентов", "API")
Rel(internet_bank, sms_gateway, "Запрашивает отправку СМС-кодов и уведомлений", "API")

Rel(abs, credit_pipeline, "Синхронизирует заявки на кредиты", "Batch/API")
Rel(abs, sms_gateway, "Запрашивает отправку СМС-уведомлений", "API")

Rel(credit_pipeline, scoring_system, "Запрашивает оценку кредитоспособности", "API")
Rel(scoring_system, bki, "Получает кредитные истории клиентов", "API")

Rel(sms_gateway, telecom, "Отправляет СМС", "API")

@enduml

